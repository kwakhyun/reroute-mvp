# 로컬 개발에서는 파일 기반 libSQL 데이터베이스를 사용합니다.
# 운영 환경에서는 원격 libSQL/Turso URL과 토큰을 사용해야 합니다.
DATABASE_URL=file:./data/reroute.db
DATABASE_AUTH_TOKEN=
ALLOW_FILE_DATABASE=false
# 신뢰할 수 있는 리버스 프록시가 전달 헤더를 덮어쓸 때만 활성화합니다. Vercel은 자동으로 신뢰합니다.
TRUST_PROXY_HEADERS=false

# 배포 환경마다 충분히 긴 무작위 값으로 설정하고 주기적으로 교체합니다.
SESSION_PEPPER=replace-with-at-least-32-random-characters

# 배포한 서비스의 공개 주소로 설정합니다.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 데모 샘플 계정을 클릭 한 번으로 열 수 있게 합니다. 실제 고객 환경에서는 false로 유지합니다.
DEMO_MODE=false

# 구조화 로그를 전송할 선택적 HTTPS 주소입니다. 토큰은 서버에서만 사용합니다.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
