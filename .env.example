# Local development uses a file-backed libSQL database.
# Production should use a remote libSQL/Turso URL and token.
DATABASE_URL=file:./data/reroute.db
DATABASE_AUTH_TOKEN=
ALLOW_FILE_DATABASE=false
# Enable only when a known reverse proxy overwrites forwarding headers. Vercel is trusted automatically.
TRUST_PROXY_HEADERS=false

# Rotate to a long random value in every deployed environment.
SESSION_PEPPER=replace-with-at-least-32-random-characters

# Set to the public origin of the deployment.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Enables an explicit, one-click portfolio sandbox account. Keep false for real deployments.
DEMO_MODE=false

# Optional HTTPS endpoint for structured log delivery. Keep the token server-side.
LOG_DRAIN_URL=
LOG_DRAIN_TOKEN=
